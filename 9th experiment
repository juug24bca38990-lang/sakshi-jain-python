EXECUTE 
import pandas as pd
import matplotlib.pyplot as plt
spl = pd.DataFrame({
    "Name": ["Sakshi", "Chetan", "Tina", "Akshat"],
    "Monthly_spend": ["60000", "40000", "65000", "50000"]
})
spl["Monthly_spend"] = spl["Monthly_spend"].astype(int)
spl_sorted = spl.sort_values(by="Monthly_spend", ascending=True)
plt.figure()
plt.bar(spl_sorted["Name"], spl_sorted["Monthly_spend"])
plt.xlabel("Name")
plt.ylabel("Monthly Spend")
plt.title("Monthly Spend (Sorted)")
plt.show()
